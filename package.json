{
  "name": "z-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Graphic User Interface tool for Zustand state management",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sub9707/Z-UI.git"
  },
  "homepage": "https://github.com/sub9707/Z-UI#readme",
  "bugs": {
    "url": "https://github.com/sub9707/Z-UI/issues"
  },
  "author": "sub9707",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @z-ui/gui dev",
    "dev:example": "pnpm --filter @z-ui/example-basic dev",
    "dev:all": "pnpm --parallel --filter \"@z-ui/gui\" --filter \"@z-ui/example-basic\" dev",
    "build": "pnpm --filter @z-ui/core build",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
