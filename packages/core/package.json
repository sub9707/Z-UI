{
  "name": "@z-ui/core",
  "version": "0.0.1",
  "description": "Zustand middleware + WebSocket dev server for Z-UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sub9707/Z-UI.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sub9707/Z-UI#readme",
  "bugs": {
    "url": "https://github.com/sub9707/Z-UI/issues"
  },
  "author": "sub9707",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "zustand": ">=4.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "zustand": "^4.5.0"
  },
  "keywords": [
    "zustand",
    "devtools",
    "state-management",
    "debugger"
  ],
  "dependencies": {
    "ws": "^8.21.0"
  }
}
